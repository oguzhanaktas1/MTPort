{
  "sourceLanguage": "tr",
  "version": "1.0",
  "strings": {
    "app.name": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MTPort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MTPort"
          }
        }
      }
    },
    "state.agentStarting": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan başlatılıyor…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting agent…"
          }
        }
      }
    },
    "state.noPhone": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon yok"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No phone"
          }
        }
      }
    },
    "state.awaitingFileTransfer": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon algılandı: Dosya aktarımını seçin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone detected: select File Transfer"
          }
        }
      }
    },
    "state.readyToMount": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon hazır"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone ready"
          }
        }
      }
    },
    "state.connecting": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlanıyor…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting…"
          }
        }
      }
    },
    "state.mounted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlandı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mounted"
          }
        }
      }
    },
    "state.transferring": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarılıyor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferring"
          }
        }
      }
    },
    "state.safeToDisconnect": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenle çıkarabilirsiniz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe to disconnect"
          }
        }
      }
    },
    "state.error": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hata"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error"
          }
        }
      }
    },
    "device.state.detected": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        }
      }
    },
    "device.state.awaitingMtp": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MTP bekleniyor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for MTP"
          }
        }
      }
    },
    "device.state.connecting": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlanıyor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting"
          }
        }
      }
    },
    "device.state.mounted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mounted"
          }
        }
      }
    },
    "device.state.draining": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkarılıyor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecting"
          }
        }
      }
    },
    "device.state.error": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hata"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error"
          }
        }
      }
    },
    "device.capacity %@ %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ boş / %2$@ toplam"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ free of %2$@"
          }
        }
      }
    },
    "hint.selectFileTransfer": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun kilidini açın, USB bildiriminden «Dosya aktarımı (MTP)» seçeneğini seçin. Kablo veri aktarabilen türden olmalı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the phone and choose “File transfer (MTP)” in its USB notification. The cable must carry data, not only power."
          }
        }
      }
    },
    "hint.readOnlyDefault": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt okunur bağlanır"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mounts read-only"
          }
        }
      }
    },
    "hint.readWrite": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuma/yazma: yazılanlar önce Mac'te hazırlanır, çıkarken tamamlanır"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read/write: writes are staged on the Mac and sent to the phone when the file is closed"
          }
        }
      }
    },
    "action.mount": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount"
          }
        }
      }
    },
    "action.openInFinder": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder'da Aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Finder"
          }
        }
      }
    },
    "action.eject": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject"
          }
        }
      }
    },
    "action.diagnostics": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanılama"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics"
          }
        }
      }
    },
    "action.quit": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çık"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        }
      }
    },
    "action.close": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "transfer.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarım"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers"
          }
        }
      }
    },
    "transfer.read": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunan"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read"
          }
        }
      }
    },
    "transfer.uploaded": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklenen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploaded"
          }
        }
      }
    },
    "transfer.files": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başarılı / başarısız"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK / failed"
          }
        }
      }
    },
    "transfer.speed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hız (ölçülen)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed (measured)"
          }
        }
      }
    },
    "transfer.preserved %llu": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklenemeyen %llu dosya Mac'te saklandı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%llu file(s) that could not be uploaded were kept on your Mac"
          }
        }
      }
    },
    "transfer.preservedHint": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar ~/Library/Caches/MTPort/Staging içinde; hiçbir şey silinmedi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files are in ~/Library/Caches/MTPort/Staging; nothing was deleted."
          }
        }
      }
    },
    "transfer.cancelUnsupported": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürümde iptal yok; «Çıkar» işlemi güvenle durdurur ve hazırlanan veriyi korur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cancel in this version; “Eject” stops safely and keeps staged data."
          }
        }
      }
    },
    "help.agentStarting": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel ajan başlatılıyor…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting the local agent…"
          }
        }
      }
    },
    "help.safeToDisconnect": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon güvenle çıkarıldı; kabloyu çekebilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone was ejected; you can unplug the cable."
          }
        }
      }
    },
    "help.noPhone": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veri kablosuyla telefonu bağlayın, kilidini açın ve USB → Dosya aktarımı (MTP) seçin. Dosyalar yalnızca Finder'da görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug the phone in with a data cable, unlock it and choose USB → File transfer (MTP). Files appear only in Finder."
          }
        }
      }
    },
    "setting.autoMount": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takınca otomatik bağla ve Finder'da aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount on plug-in and open in Finder"
          }
        }
      }
    },
    "setting.launchAtLogin": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açılışında başlat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login"
          }
        }
      }
    },
    "setting.noCloud": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut yok, ağ yok: her şey bu Mac'te kalır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cloud, no network: everything stays on this Mac."
          }
        }
      }
    },
    "error.agentMissing": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "mtport-agent bulunamadı. Önce scripts/build-native.sh çalıştırın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "mtport-agent was not found. Run scripts/build-native.sh first."
          }
        }
      }
    }
  }
}